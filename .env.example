# ========================================================================
# DaisanAI Lite v0.7 — File cau hinh bien moi truong
# ========================================================================
# Cach copy:  copy .env.example .env  (Windows)
#             cp   .env.example .env  (Mac/Linux)
# ========================================================================


# ─── Server ─────────────────────────────────────────────────────────────
PORT=3001


# ─── Supabase ────────────────────────────────────────────────────────────
SUPABASE_URL=https://owynuxlvtcvxbynrxvsj.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── Claude API ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ─── VNPay (v0.7 — optional, neu khong dien se chay MOCK mode) ──────────
# Dang ky sandbox tai: https://sandbox.vnpayment.vn
# Khi nao co tai khoan, dien vao day. Khong dien → mock upgrade (de test UX)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Production URL (khi nao co tai khoan that):
# VNP_URL=https://pay.vnpay.vn/vpcpay.html


# ─── Custom domain (v0.8 — production only) ────────────────────────────
# Public IP cua server (dung trong DNS instructions cho user)
# Local dev khong can dien, chi can khi deploy production VPS
SERVER_PUBLIC_IP=


# ─── Email notify (v0.15 — Resend, optional) ──────────────────────────
# Khong dien thi tinh nang email notify khi co lead moi se SKIP silently
# Dang ky free tai: https://resend.com (3000 email/thang free)
# Setup: SETUP_EMAIL_NOTIFY.md
RESEND_API_KEY=
# From address: phai la verified domain trong Resend, hoac dung default sandbox
# Sandbox: chi gui duoc den email cua chu account Resend, dung de test
FROM_EMAIL=DaisanAI <onboarding@resend.dev>
# URL base de tao deep-link "Mo trong app" trong email
APP_BASE_URL=https://webbuilder.daisan.ai


# ─── Frontend (Vite) ────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://owynuxlvtcvxbynrxvsj.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_URL=http://localhost:3001
