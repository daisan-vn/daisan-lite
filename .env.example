# ========================================================================
# DaisanAI Lite — File cau hinh bien moi truong
# ========================================================================
# Huong dan: COPY file nay thanh ".env" (bo .example) roi dien gia tri vao
#
# Cach copy tren Windows (mo Terminal trong VS Code):
#   copy .env.example .env
# ========================================================================

# --- Server (backend) ---
PORT=3001

# --- Supabase ---
# Lay tu: https://supabase.com/dashboard → Project → Settings → API
SUPABASE_URL=https://owynuxlvtcvxbynrxvsj.supabase.co

# anon key (public, dung o frontend) — bat dau bang "sb_publishable_..."
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# service_role key (BI MAT, chi dung o backend) — bat dau bang "eyJ..."
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Claude API (Anthropic) ---
# Lay tu: https://console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Frontend (Vite) ---
# Cac bien co prefix VITE_ se duoc dua vao client (KHONG dat key bi mat o day!)
VITE_SUPABASE_URL=https://owynuxlvtcvxbynrxvsj.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_API_URL=http://localhost:3001
